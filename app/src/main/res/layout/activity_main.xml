<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_video" />

        <Button
            android:id="@+id/pick_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pick_video" />

        <TextView
            android:id="@+id/video_status"
            style="@style/Hint"
            android:text="@string/no_video" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_playback" />

        <Switch
            android:id="@+id/loop"
            style="@style/Option"
            android:text="@string/loop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/play_count_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/play_count"
                android:textSize="16sp" />

            <NumberPicker
                android:id="@+id/play_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Switch
            android:id="@+id/end_on_last_frame"
            style="@style/Option"
            android:text="@string/end_on_last_frame" />

        <TextView
            style="@style/Hint"
            android:text="@string/end_on_last_frame_hint" />

        <Switch
            android:id="@+id/sound"
            style="@style/Option"
            android:text="@string/sound" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_start" />

        <Switch
            android:id="@+id/after_unlock"
            style="@style/Option"
            android:text="@string/after_unlock" />

        <TextView
            style="@style/Hint"
            android:text="@string/after_unlock_hint" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_replay" />

        <Switch
            android:id="@+id/replay"
            style="@style/Option"
            android:text="@string/replay" />

        <TextView
            style="@style/Hint"
            android:text="@string/replay_hint" />

        <Switch
            android:id="@+id/replay_after_lock"
            style="@style/Option"
            android:paddingStart="24dp"
            android:text="@string/replay_after_lock" />

        <TextView
            style="@style/Hint"
            android:paddingStart="24dp"
            android:text="@string/replay_after_lock_hint" />

        <Switch
            android:id="@+id/replay_on_home"
            style="@style/Option"
            android:paddingStart="24dp"
            android:text="@string/replay_on_home" />

        <Button
            android:id="@+id/reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/reset" />

        <Button
            android:id="@+id/set_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_wallpaper" />

        <TextView
            android:id="@+id/wallpaper_status"
            style="@style/Hint" />
    </LinearLayout>
</ScrollView>
